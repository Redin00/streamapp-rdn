# Copy this file to .env in the repository root for local development.

# TMDB API Key (Optional: if left empty, a built-in default key is used automatically.
# Setting your own free key is recommended for dedicated rate limits:
# https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Web app and local Python service
SC_PORT=8000
# STREAMING_API_URL is set automatically by npm run dev.
# STREAMING_API_URL=http://localhost:8000

# Vixsrc playback & catalogue host (default fallback / seed domain; defaults to vixsrc.to)
# NOTE: If changed from the /admin panel, the setting is saved in the SQLite database
# (app_settings) and takes precedence over this environment variable.
SC_VIXSRC_DOMAIN=vixsrc.to

# Response cache TTL in seconds (default 1800)
SC_CACHE_TTL=1800
SC_CORS_ORIGINS=*
SC_LOG_LEVEL=INFO

# Accounts and per-account state
# SC_DB_PATH defaults to python-service/data/streamapp.db
SC_DB_PATH=
SC_ADMIN_NAME=Admin
# Default initial admin password when left empty is: admin123
SC_ADMIN_PASSWORD=admin123
SC_SESSION_DAYS=30
SC_LOCKOUT_MINUTES=15

# Profile pictures and service URLs
# SC_UPLOAD_DIR defaults to python-service/uploads
# SC_PROFILE_PICTURES_DIR defaults to python-service/uploads
# SC_BASE_URL is needed when picture URLs must use a public API URL.
SC_UPLOAD_DIR=
SC_PROFILE_PICTURES_DIR=
SC_BASE_URL=
SC_MAX_PROFILE_PICTURE_MB=2